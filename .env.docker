APP_UID=1000
APP_GID=1000

FRONTEND_PORT=2000
FRONTEND_DEV_PORT=2000
BACKEND_PORT=8000
POSTGRES_PORT=5432
RABBITMQ_PORT=5672

POSTGRES_DB=ciot_db
POSTGRES_USER=ciot
POSTGRES_PASSWORD=imis95510
KVGH_DATABASE_URL=postgresql+psycopg2://ciot:imis95510@postgres:5432/ciot_db

RABBITMQ_DEFAULT_USER=ciot_borker
RABBITMQ_DEFAULT_PASS=change_me_broker_password
RABBITMQ_DEFAULT_VHOST=KVGH_reha_vhost
KVGH_CELERY_BROKER_URL=amqp://ciot_borker:change_me_broker_password@rabbitmq:5672/KVGH_reha_vhost
KVGH_CELERY_RESULT_BACKEND=rpc://

KVGH_AUTH_SECRET_KEY=replace_me_with_a_long_random_secret
KVGH_SESSION_COOKIE_DOMAIN=
KVGH_SESSION_COOKIE_SAMESITE=lax
KVGH_SESSION_COOKIE_SECURE=false
KVGH_CORS_ALLOWED_ORIGINS=
KVGH_CORS_ALLOW_CREDENTIALS=true

KVGH_DEV_NODE_NAME=docker-dev-node
KVGH_PROD_NODE_NAME=docker-prod-node
METRICS_QUEUE_PREFIX=gpu_metrics
METRICS_DISPATCH_QUEUE=gpu_metrics_dispatch
VIDEO_AUTOSCALE_MIN=2
VIDEO_AUTOSCALE_MAX=4
SCRIPT_AUTOSCALE_MIN=1
SCRIPT_AUTOSCALE_MAX=2
# =2（非1）：autoscale 以 len(reserved_requests) 判斷擴張，prefetch=1 會讓 reserved 卡在 ≤1、pool 永遠縮在 min。
# prefetch_count = autoscale_max(2) × 2 = 4 → 有 backlog 時 reserved 可達 ≥2 → autoscaler 才會擴到 2。
SCRIPT_PREFETCH_MULTIPLIER=2
HUMANPOSE_AUTOSCALE_MIN=1
HUMANPOSE_AUTOSCALE_MAX=2
ANNOTATION_AUTOSCALE_MIN=1
ANNOTATION_AUTOSCALE_MAX=8

# AlphaPose 批次參數（per-node 固定配置，直接決定單任務 VRAM 峰值；
# 調整時必須同步校準 DB system_runtime_settings 的 gpu_required_vram_mb）。
# RTX 2080 8GB / capacity 2 的保守值；B200 等大卡可調高（如 5/64/512）。
KVGH_ALPHAPOSE_DETBATCH=1
KVGH_ALPHAPOSE_POSEBATCH=16
KVGH_ALPHAPOSE_QSIZE=64

ANALYSIS_HOST_ROOT=/home/ciot/physiotherapy_vghks
VITE_BACKEND_ORIGIN=http://backend-api:8000
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=compute,utility,video
